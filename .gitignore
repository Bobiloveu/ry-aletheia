# Python and frontend caches
__pycache__/
*.py[cod]
.pytest_cache/
.pixi/
.worktrees/
frontend/node_modules/
frontend/.pytest_cache/
tools/pyinstaller/
autodrive_console/web-vue/

# Local build outputs and release artifacts (reproducible from source)
build/
dist/
releases/
.cache/
.ry-aletheia-signing/
*.deb
*.tar.gz

# Versioned minimum robot build overlay; contains only the approved interface packages.
!third_party/
!third_party/robot_build_deps/
!third_party/robot_build_deps/*.tar.gz
!third_party/robot_build_deps/*.tar.gz.sha256

# Robot/runtime state; never commit test evidence or field logs
install/
reports/
logs/
maps_cache/
deployments/
updates/
config/console.json
config/case_workspace.json
config/scenario_setup.json
config/scenario_backups/

# OS/editor noise
.DS_Store
*.swp
