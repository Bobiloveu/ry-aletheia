#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/ry_aletheia"
if [[ ! -x "$ROOT/dist/ry-aletheia" ]]; then
  echo "RY Aletheia 未安装到 $ROOT，或当前账户不是安装账户。" >&2
  exit 1
fi
# 在操作者的实际终端环境中加载 ROS，保留 ROS_DOMAIN_ID、DDS 和桌面会话配置。
if [[ -f "$HOME/.bashrc" ]]; then
  set +u
  source "$HOME/.bashrc"
  set -u
fi
if [[ -f /opt/ry/install/setup.bash ]]; then
  set +u
  source /opt/ry/install/setup.bash
  set -u
fi
cd "$ROOT"
# Keep older user-level systemd units compatible with the vehicle DDS domain.
# New units also inject this value directly, but upgrades must repair units
# created before that setting existed.  Respect an explicitly exported domain
# from the operator's shell; otherwise use the persisted video ROS domain.
if [[ -z "${ROS_DOMAIN_ID:-}" && -f "$ROOT/config/video.json" ]]; then
  configured_domain="$(awk -F: '/"ros_domain_id"[[:space:]]*:/ { gsub(/[^0-9]/, "", $2); print $2; exit }' "$ROOT/config/video.json")"
  if [[ "$configured_domain" =~ ^[0-9]+$ ]] && (( configured_domain <= 232 )); then
    export ROS_DOMAIN_ID="$configured_domain"
  fi
fi
exec "$ROOT/dist/ry-aletheia"
