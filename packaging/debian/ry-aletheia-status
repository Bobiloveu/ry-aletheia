#!/usr/bin/env bash
# RY Aletheia 按需资源状态页。工具由普通用户直接运行，不依赖 systemd。
#
# PyInstaller onefile 会留下一个很轻的引导父进程，再由子进程提供 Web 服务。
# 因此不能再用 pgrep 的第一个命中项作为主进程；这里以实际占用 8087 的服务
# 进程为准。CPU 则按该服务进程的完整子进程树做 /proc CPU 时间区间采样，覆盖
# 控制台、专用遥测、预处理、MediaMTX 和视频编码器，而非 ps 的生命周期平均值。
set -euo pipefail

INTERVAL_S=1
ONCE=false

usage() {
  printf '用法：ry-aletheia-status [--once]\n'
}

case "${1:-}" in
  '') ;;
  --once) ONCE=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

console_pid() {
  local pid command

  # ss 给出真正监听 Web 端口的子进程 PID；同一用户可读取，不需要 sudo。
  pid="$(ss -ltnpH 2>/dev/null | sed -nE '/:8087([[:space:]]|$)/ s/.*pid=([0-9]+).*/\1/p' | head -n 1 || true)"
  if [[ -n "$pid" ]]; then
    command="$(ps -p "$pid" -o args= 2>/dev/null || true)"
    if [[ "$command" == *'/ry_aletheia/dist/ry-aletheia'* ]]; then
      printf '%s\n' "$pid"
      return
    fi
  fi

  # 端口尚未就绪时才降级为进程匹配，优先选有同名父进程的运行子进程。
  local candidate parent parent_command fallback=''
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    command="$(ps -p "$candidate" -o args= 2>/dev/null || true)"
    [[ "$command" == *' --video-runner'* ]] && continue
    fallback="$candidate"
    parent="$(ps -p "$candidate" -o ppid= 2>/dev/null | tr -d ' ' || true)"
    parent_command="$(ps -p "${parent:-0}" -o args= 2>/dev/null || true)"
    if [[ "$parent_command" == *'/ry_aletheia/dist/ry-aletheia'* ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done < <(pgrep -f '/ry_aletheia/dist/ry-aletheia([[:space:]]|$)' 2>/dev/null || true)
  printf '%s\n' "$fallback"
}

video_runner_pid() {
  pgrep -f '/ry_aletheia/dist/ry-aletheia --video-runner([[:space:]]|$)' 2>/dev/null | head -n 1 || true
}

format_mib() {
  awk -v value="${1:-0}" 'BEGIN { printf "%.1f", value / 1024 }'
}

tool_tree_pids() {
  local root_pid="$1" current child
  local -a queue=("$root_pid")
  local -A seen=()

  # onefile 运行时会把 C++ 预处理器解压到 /tmp/_MEI*。按安装路径过滤会遗漏它们；
  # 以 8087 服务进程为根遍历后代，既包含这些自有 helper，也不会计入原机器人 ROS
  # 驱动、导航等非 Aletheia 进程。
  while (( ${#queue[@]} > 0 )); do
    current="${queue[0]}"
    queue=("${queue[@]:1}")
    [[ "$current" =~ ^[0-9]+$ ]] || continue
    [[ -z "${seen[$current]:-}" ]] || continue
    [[ -d "/proc/$current" ]] || continue
    seen["$current"]=1
    printf '%s\n' "$current"
    while IFS= read -r child; do
      [[ "$child" =~ ^[0-9]+$ ]] && queue+=("$child")
    done < <(pgrep -P "$current" 2>/dev/null || true)
  done
}

tool_tick_snapshot() {
  local root_pid="$1" pid ticks
  # 对同一 pid 的两次快照求差，避免新建进程的历史 jiffies 误计入本次采样。
  while IFS= read -r pid; do
    [[ -r "/proc/$pid/stat" ]] || continue
    ticks="$(awk '{print $14 + $15}' "/proc/$pid/stat" 2>/dev/null || true)"
    [[ "$ticks" =~ ^[0-9]+$ ]] && printf '%s %s\n' "$pid" "$ticks"
  done < <(tool_tree_pids "$root_pid")
}

tool_cpu_percent() {
  local root_pid="$1" started ended before after pid ticks elapsed delta=0
  local -A before_ticks=()
  while read -r pid ticks; do
    before_ticks["$pid"]="$ticks"
  done < <(tool_tick_snapshot "$root_pid")
  [[ ${#before_ticks[@]} -gt 0 ]] || return 1
  started="$(awk '{print $1}' /proc/uptime 2>/dev/null || true)"
  sleep "$INTERVAL_S"
  ended="$(awk '{print $1}' /proc/uptime 2>/dev/null || true)"
  while read -r pid ticks; do
    [[ -n "${before_ticks[$pid]:-}" ]] || continue
    (( delta += ticks - before_ticks[$pid] ))
  done < <(tool_tick_snapshot "$root_pid")
  elapsed="$(awk -v end="$ended" -v start="$started" 'BEGIN { value = end - start; if (value > 0) printf "%.6f", value }')"
  [[ -n "$elapsed" ]] || return 1
  awk -v ticks="$delta" -v seconds="$elapsed" -v hz="$(getconf CLK_TCK 2>/dev/null || echo 100)" 'BEGIN { printf "%.1f", ticks / hz / seconds * 100 }'
}

print_tool_cpu() {
  local root_pid="$1" sampled fallback
  sampled="$(tool_cpu_percent "$root_pid" 2>/dev/null || true)"
  if [[ -n "$sampled" ]]; then
    printf '工具总 CPU:   %s%%  （近 %ss；100%% = 一个逻辑 CPU 核心）\n' "$sampled" "$INTERVAL_S"
    return
  fi
  # /proc 被容器策略隐藏时仍保留可用的降级值，并明确标识其不是瞬时采样。
  fallback="$(ps -p "$root_pid" -o %cpu= 2>/dev/null | tr -d ' ' || true)"
  printf '工具总 CPU:   %s%%  （/proc 不可用，ps 平均值）\n' "${fallback:-—}"
}

print_process_metrics() {
  local pid="$1" rss threads elapsed command
  read -r rss threads elapsed command < <(ps -p "$pid" -o rss=,nlwp=,etime=,args= 2>/dev/null || true)
  printf '服务 PID:     %s\n' "$pid"
  printf '内存占用:     %s MiB\n' "$(format_mib "${rss:-0}")"
  printf '线程数:       %s\n' "${threads:-—}"
  printf '运行时长:     %s\n' "${elapsed:-—}"
  printf '命令:         %s\n' "${command:-—}"
}

print_video_metrics() {
  local runner pgid metrics count cpu rss threads
  runner="$(video_runner_pid)"
  if [[ -z "$runner" ]]; then
    printf '视频运行器:   未运行\n'
    return
  fi

  pgid="$(ps -p "$runner" -o pgid= 2>/dev/null | tr -d ' ' || true)"
  if [[ -z "$pgid" ]]; then
    printf '视频运行器:   PID %s（正在退出）\n' "$runner"
    return
  fi
  metrics="$(ps -eo pgid=,pcpu=,rss=,nlwp= | awk -v target="$pgid" '
    $1 == target { count += 1; cpu += $2; rss += $3; threads += $4 }
    END { printf "%d %.1f %d %d", count, cpu, rss, threads }
  ')"
  read -r count cpu rss threads <<< "$metrics"
  printf '视频运行器:   运行中（PID %s，进程组 %s）\n' "$runner" "$pgid"
  printf '视频资源:     %s 个进程 · %s%% CPU · %s MiB · %s 线程\n' \
    "$count" "$cpu" "$(format_mib "$rss")" "$threads"
}

print_video_api_status() {
  local payload
  payload="$(curl -fsS --connect-timeout 1 --max-time 2 http://127.0.0.1:8087/api/video/status 2>/dev/null || true)"
  if [[ -z "$payload" ]]; then
    printf '视频流状态:   状态接口不可用\n'
    return
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf '视频流状态:   状态接口可达（未安装 Python，无法展开各路状态）\n'
    return
  fi

  printf '%s' "$payload" | python3 -c '
import json
import sys

try:
    document = json.load(sys.stdin)
except (json.JSONDecodeError, TypeError):
    print("视频流状态:   状态接口返回无效数据")
    raise SystemExit(0)

state_names = {
    "online": "在线",
    "waiting": "等待 ROS 图像",
    "offline": "离线",
    "disabled": "已关闭",
    "error": "异常",
}
print("视频总开关:   {}".format("已启用" if document.get("enabled") else "已关闭"))
for stream in document.get("streams", []):
    name = stream.get("name", "unknown")
    enabled = "开" if stream.get("enabled") else "关"
    state = state_names.get(stream.get("status"), stream.get("status", "未知"))
    print("  - {:<18} {} / {}".format(name, enabled, state))
'
}

render_status() {
  local pid
  pid="$(console_pid)"

  if [[ "$ONCE" == false ]]; then
    printf '\033[H\033[2J'
    printf 'RY Aletheia · 实时资源状态（每 %ss 刷新，Ctrl+C 退出）\n\n' "$INTERVAL_S"
  else
    printf 'RY Aletheia · 资源状态\n\n'
  fi

  if [[ -z "$pid" ]]; then
    printf '工具状态:     未运行（8087 未监听）\n\n'
    printf '提示：请以普通账户执行 ry-aletheia 启动控制台。\n'
    return
  fi

  printf '工具状态:     运行中（8087 已监听）\n'
  print_tool_cpu "$pid"
  print_process_metrics "$pid"
  printf '\n'
  print_video_metrics
  print_video_api_status
}

while true; do
  if ! render_status; then
    sleep "$INTERVAL_S"
  fi
  [[ "$ONCE" == true ]] && exit 0
done
